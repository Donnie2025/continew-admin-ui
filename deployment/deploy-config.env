# continew-admin-ui 部署配置文件
# 请根据实际情况修改以下配置

# 服务器配置
SERVER_HOST="152.136.228.124"
SERVER_USER="root"
SERVER_PATH="/www/wwwroot/continew-admin-ui"

# Nginx配置
NGINX_CONFIG="/etc/nginx/sites-available/continew-admin-ui"

# 备份配置
BACKUP_DIR="/var/backups/continew-admin-ui"

# SSL配置（可选）
SSL_CERT_PATH="/etc/ssl/certs/continew-admin-ui.crt"
SSL_KEY_PATH="/etc/ssl/private/continew-admin-ui.key"

# 域名配置
DOMAIN_NAME="admin.yourdomain.com"

# 监控配置（可选）
ENABLE_MONITORING=true
MONITORING_EMAIL="admin@yourdomain.com"

# 自动备份配置
AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30
